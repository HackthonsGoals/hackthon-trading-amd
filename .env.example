# ---------------------------------------------------------------------------
# AMD GPU-Accelerated AI Signal Pipeline — environment variable template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Required for LLM reasoning using Fireworks AI (Qwen3-8B).
# Without this key the app runs in local demo mode and shows a fallback
# explanation string instead of a live LLM response.
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Optional: override the ticker universe (comma-separated symbols).
# Default: AMD,NVDA,TSM,INTC,AVGO,SMCI,QCOM,MU
TICKER_UNIVERSE=AMD,NVDA,TSM,INTC,AVGO,SMCI,QCOM,MU

# Optional: override the Fireworks model used for signal reasoning.
# Default: accounts/fireworks/models/qwen3-8b
FIREWORKS_MODEL_NAME=accounts/fireworks/models/qwen3-8b
